# Normalizar line endings
* text=auto

# Forcar LF em arquivos de codigo
*.ts    text eol=lf
*.tsx   text eol=lf
*.js    text eol=lf
*.json  text eol=lf
*.css   text eol=lf
*.md    text eol=lf
*.sql   text eol=lf
*.py    text eol=lf
*.txt   text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf

# Binarios
*.docx  binary
*.png   binary
*.jpg   binary
*.ico   binary