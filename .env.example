# ============================================================
#  INARA — Variáveis de Ambiente
#  Copie este arquivo para .env.local (Next.js) e .env (FastAPI)
#  NUNCA commite os arquivos com valores reais.
# ============================================================

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
# Token secreto enviado no header X-Telegram-Bot-Api-Secret-Token
WEBHOOK_SECRET_TOKEN=

# --- Google Gemini ---
GEMINI_API_KEY=

# --- Aplicação ---
# URL pública do serviço FastAPI (ex: https://inara-bot.fly.dev)
WEBHOOK_SERVICE_URL=
# URL pública do Next.js (ex: https://inara.vercel.app)
NEXT_PUBLIC_APP_URL=
